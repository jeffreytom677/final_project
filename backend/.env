# ==============================================================================
# BACKEND CONFIGURATION
# ==============================================================================
# Port for Express server (default: 5000)
PORT=5000

# MongoDB Connection String:
# >>> REPLACE THE PLACEHOLDER BELOW WITH YOUR MONGODB ATLAS CONNECTION STRING <<<
# Example Atlas URI:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/recipebook?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/recipebook?retryWrites=true&w=majority
